# Git Ignore File
# Specifies intentionally untracked files that Git should ignore
#
# Author: Lashe Onamusi
# Date: December 2026

# ==============================================================================
# PYTHON
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
venv_new/
env/
ENV/
.venv/

# PyCharm
.idea/

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
.hypothesis/

# ==============================================================================
# NODE / REACT
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production build
/build

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# DATABASE
# ==============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3
instance/

# ==============================================================================
# ENVIRONMENT VARIABLES
# ==============================================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.development
.env.production
.env.*.local

# ==============================================================================
# OPERATING SYSTEM
# ==============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ==============================================================================
# IDE / EDITORS
# ==============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==============================================================================
# LOGS
# ==============================================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# TEMPORARY FILES
# ==============================================================================

tmp/
temp/
*.tmp
*.bak
*.swp

# ==============================================================================
# DOCKER (OPTIONAL - Usually you want these in Git)
# ==============================================================================

# Uncomment if you don't want to track these:
# Dockerfile
# docker-compose*.yml
# .dockerignore

# ==============================================================================
# CI/CD
# ==============================================================================

# Usually you WANT these in Git, but listing here for reference:
# .github/
# .gitlab-ci.yml
# .travis.yml

# ==============================================================================
# MISC
# ==============================================================================

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Backup files
*.backup
*.bak
