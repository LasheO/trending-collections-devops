# Environment Variables Template
# 
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#
# Author: Lashe Onamusi
# Date: December 2026

# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Flask Application Secret (for session management)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# JWT Secret Key (for token signing)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database URI
# Development: sqlite:///app.db
# Production: Use environment-specific database
SQLALCHEMY_DATABASE_URI=sqlite:///app.db

# Database options
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# API Base URL
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
REACT_APP_API_URL=http://localhost:5000

# Application Name
REACT_APP_NAME=Trending Collections

# ==============================================================================
# DEPLOYMENT CONFIGURATION (RENDER)
# ==============================================================================

# Port (Render will set this automatically)
PORT=5000

# Python Version
PYTHON_VERSION=3.11.0

# Node Version
NODE_VERSION=18.0.0

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
#
# 1. Never commit .env file to Git
# 2. Use different secrets for development and production
# 3. Rotate secrets periodically
# 4. Use strong, random values for all secret keys
# 5. On Render, set these in the Environment Variables section
#
# ==============================================================================
